---
import Map from '@/icons/Map.astro';

interface Props {
	title: string;
	address: string;
}

const { title, address } = Astro.props;
---
<article
	class="group flex h-full flex-col rounded-2xl border border-border-warm bg-card p-5 transition-colors hover:border-primary-400/45 sm:p-6 dark:border-border-warm-dark dark:bg-card-dark dark:hover:border-primary-500/40"
>
	<h3 class="text-lg font-black tracking-tight text-foreground dark:text-inverse">
		{title}
	</h3>
	<div class="my-3 h-1 w-10 rounded-sm bg-primary-500 transition-[width] duration-300 group-hover:w-14 dark:bg-primary-400" aria-hidden="true"></div>
	<p class="flex items-start gap-2.5 text-sm leading-relaxed text-muted dark:text-inverse-muted">
		<Map extraClass="mt-0.5 shrink-0 text-primary-500 dark:text-primary-400" />
		<span>{address}</span>
	</p>
</article>
