---
interface Props {
	img: string;
	imgDark?: string;
	title: string;
	titleDark?: string;
	index: number;
	accent: string;
	line: string;
}
const { img, title, imgDark, titleDark, index, accent, line } = Astro.props;
const anchor = title.toLowerCase().replace(/\s/g, '_');
const altText = titleDark ?? title;
const num = String(index).padStart(2, '0');
---
<a
	href={'#' + anchor}
	data-animate="card"
	class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-inverse/10 bg-inverse/5 transition-[background,border-color] duration-250 ease-out hover:border-[color-mix(in_srgb,var(--accent)_50%,transparent)] hover:bg-[color-mix(in_srgb,var(--accent)_12%,rgba(255,252,247,0.05))]"
	style={`--accent: ${accent}`}
>

	<div class="flex flex-1 flex-col items-center justify-between gap-4 px-5 pt-7 pb-5">
		<div class="flex min-h-20 w-full flex-1 items-center justify-center">
			<img
				class="max-h-18 max-w-[85%] object-contain transition-transform duration-250 ease-out group-hover:scale-[1.03] dark:hidden sm:max-h-16 lg:max-h-18"
				src={img}
				alt={'Logo de marca ' + altText}
				loading="lazy"
			/>
			<img
				class="hidden max-h-18 max-w-[85%] object-contain transition-transform duration-250 ease-out group-hover:scale-[1.03] dark:block sm:max-h-16 lg:max-h-18"
				src={imgDark ?? img}
				alt={'Logo de marca ' + altText}
				loading="lazy"
			/>
		</div>
		<div class="min-h-11 w-full text-center">
			<span class="block text-[0.8rem] font-bold tracking-wider text-inverse uppercase">{title}</span>
			<span class="mt-1 block text-[0.68rem] tracking-wide text-inverse-subtle">{line}</span>
		</div>
	</div>
	<span
		class="block h-[3px] origin-left scale-x-[0.3] bg-(--accent) transition-transform duration-300 ease-out group-hover:scale-x-100"
		aria-hidden="true"
	></span>
</a>
