---
interface Props {
	title: string;
	subtitle: string;
}

const { title, subtitle } = Astro.props;
---
<article class="scroll-mt-28">
	<header class="relative mb-8 overflow-hidden rounded-2xl border border-border-warm bg-tint px-6 py-6 sm:px-8 sm:py-7 dark:border-border-warm-dark dark:bg-tint-dark">
		<div
			class="pointer-events-none absolute inset-0 bg-[color-mix(in_srgb,var(--color-primary-500)_6%,transparent)]"
			aria-hidden="true"
		></div>
		<div class="relative flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="mb-2 text-[0.72rem] font-semibold tracking-[0.28em] text-primary-600 uppercase dark:text-primary-300">
					Provincia
				</p>
				<h2 class="text-3xl font-black tracking-tight text-primary-700 sm:text-4xl dark:text-primary-300">
					{title}
				</h2>
			</div>
			{
				subtitle && (
					<span class="inline-flex w-fit shrink-0 rounded-full border border-primary-500/25 bg-primary-500/10 px-4 py-2 text-xs font-bold tracking-[0.16em] text-primary-700 uppercase dark:text-primary-300">
						{subtitle}
					</span>
				)
			}
		</div>
		<div class="relative mt-5 h-1.5 w-24 rounded-sm bg-primary-500 dark:bg-primary-400" aria-hidden="true"></div>
	</header>

	<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3 xl:gap-5">
		<slot />
	</div>
</article>
