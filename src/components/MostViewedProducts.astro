---
import MostViewedProduct from '@/components/MostViewedProduct.astro';
---
<section class="relative overflow-hidden bg-body py-20 lg:py-28 dark:bg-body-dark">
	<div class="relative z-10 mx-auto max-w-7xl px-6">
		<header data-animate="section-header" class="mb-14 text-center">
			<p class="mb-4 text-[0.72rem] font-semibold tracking-[0.28em] text-primary-600 uppercase dark:text-primary-300">
				Destacados
			</p>
			<h2 class="text-3xl font-black tracking-tight text-foreground sm:text-4xl lg:text-5xl dark:text-inverse">
				Productos más vistos
			</h2>
			<div class="mx-auto mt-5 h-1 w-16 rounded-sm bg-primary-500 dark:bg-primary-400" aria-hidden="true"></div>
			<p class="mx-auto mt-5 max-w-lg text-base text-muted dark:text-inverse-muted">
				Los más demandados de nuestras marcas
			</p>
		</header>

		<div class="grid gap-6 md:grid-cols-2 lg:gap-8">
			<MostViewedProduct
				brand="aral"
				title="Gelatinas"
				subtitle="Aral"
				description="Presentación: 1Kg y 3Kg.<br/>Sabores: Cereza, Frutilla, Frambuesa, Naranja, Durazno, Ananá, Limón, Manzana Verde y Pera"
				img="images/aral/gelatinas/1kg/aral_gelatina_frutilla_1kg.webp"
			/>
			<MostViewedProduct
				brand="sabores"
				title="Caldos con sal"
				subtitle="Sabores del Sol"
				description="Presentación: 5g, 250g, 660g y 5Kg.<br/>Sabores: Verduras, Carne, Pollo y Finas Hierbas"
				img="images/sabores_del_sol/caldos_deshidratados/660g/sabores_del_sol_caldo_verdura_660g.webp"
			/>
			<MostViewedProduct
				brand="sabores"
				title="Sopas con fideos"
				subtitle="Sabores del Sol"
				description="Presentación: 110g.<br/>Variedades: Fideos Coditos, Fideos de Letras y Fideos Ave María"
				img="images/sabores_del_sol/sopas_fideos/sabores_del_sol_sopa_fideos.webp"
			/>
			<MostViewedProduct
				brand="sabores"
				title="Sopas crema"
				subtitle="Sabores del Sol"
				description="Presentación: 68g y 1Kg.<br/>Sabores: Verduras, Pollo, Arvejas, Espárragos y Choclo"
				img="images/sabores_del_sol/sopas_crema/68g/sabores_del_sol_sopa_verduras_68g.webp"
			/>
		</div>
	</div>
</section>
