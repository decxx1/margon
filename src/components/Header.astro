---
import ColorModeSwitcher from '@/components/ColorModeSwitcher.vue';
import Menu from '@/components/Menu.vue';
import Phone from '@/icons/Phone.astro';
import Map from '@/icons/Map.astro';
import {
    telphoneReadble,
    telphoneLinkeable,
    address,
    mapUrl
} from '@/hooks/env.js'
---

<nav
	class="top-header grid grid-rows-[1fr] border-b border-primary-200 opacity-100 transition-[grid-template-rows,opacity,border-color] duration-500 ease-in-out bg-tint dark:border-primary-700/30 dark:bg-tint-dark [&.is-hidden]:pointer-events-none [&.is-hidden]:grid-rows-[0fr] [&.is-hidden]:border-transparent [&.is-hidden]:opacity-0"
>
	<div class="overflow-hidden">
		<div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 md:px-6">
			<a
				href={'tel:' + telphoneLinkeable}
				class="flex items-center text-sm font-medium text-muted transition-colors hover:text-primary-600 dark:text-inverse-muted dark:hover:text-primary-300"
			>
				<Phone extraClass="mr-2 text-primary-500 dark:text-primary-400" />
				{telphoneReadble}
			</a>
			<a
				href={mapUrl}
				class="hidden items-center text-sm font-medium text-muted transition-colors hover:text-primary-600 sm:flex dark:text-inverse-muted dark:hover:text-primary-300"
			>
				<Map extraClass="mr-2 text-primary-500 dark:text-primary-400" />
				{address}
			</a>
		</div>
	</div>
</nav>

<header
	class="header top-0 z-50 border-b border-border-warm bg-body transition-all duration-300 dark:border-border-warm-dark dark:bg-body-dark [&.is-scrolled]:sticky [&.is-scrolled]:top-0 [&.is-scrolled]:border-primary-200 [&.is-scrolled]:bg-body/95 [&.is-scrolled]:shadow-[0_4px_24px_-12px_rgba(113,47,29,0.12)] [&.is-scrolled]:backdrop-blur-md dark:[&.is-scrolled]:border-border-warm-dark dark:[&.is-scrolled]:bg-body-dark/95 dark:[&.is-scrolled]:shadow-[0_4px_24px_-12px_rgba(0,0,0,0.35)]"
>
	<nav class="px-4 py-4 lg:px-6">
		<div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between">
			<a href="./" class="flex items-center">
				<img
					loading="lazy"
					src="images/logos/margon_logo_corto.webp"
					class="h-5 sm:h-6 dark:hidden"
					alt="Margon Logo"
				/>
				<img
					loading="lazy"
					src="images/logos/margon_logo_corto_blanco.webp"
					class="hidden h-5 sm:h-6 dark:block"
					alt="Margon Logo"
				/>
			</a>
			<div class="flex items-center lg:order-2">
				<ColorModeSwitcher client:load />
				<button
					data-collapse-toggle="mobile-menu-2"
					type="button"
					class="ml-2 inline-flex items-center rounded-xl border border-border-warm p-2 text-muted transition-colors hover:border-primary-400 hover:text-primary-600 focus:outline-none lg:hidden dark:border-border-warm-dark dark:bg-card-dark dark:text-inverse-muted dark:hover:border-primary-400/40 dark:hover:text-primary-300"
					aria-controls="mobile-menu-2"
					aria-expanded="false"
				>
					<span class="sr-only">Abrir menú</span>
					<svg class="h-6 w-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
						<path
							fill-rule="evenodd"
							d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
							clip-rule="evenodd"></path>
					</svg>
					<svg class="hidden h-6 w-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
						<path
							fill-rule="evenodd"
							d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
							clip-rule="evenodd"></path>
					</svg>
				</button>
			</div>
			<div
				class="hidden w-full flex-col lg:order-1 lg:flex lg:w-auto lg:flex-row lg:items-center lg:justify-between"
				id="mobile-menu-2"
			>
				<Menu client:load />
			</div>
		</div>
	</nav>
</header>

<script is:inline>
	const header = document.querySelector('.header');
	const topHeader = document.querySelector('.top-header');

	const updateHeader = () => {
		const scrolled = window.scrollY > 8;
		header?.classList.toggle('is-scrolled', scrolled);
		topHeader?.classList.toggle('is-hidden', scrolled);
	};

	updateHeader();
	window.addEventListener('scroll', updateHeader, { passive: true });
</script>
