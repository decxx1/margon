---
import Whatsapp from '@/icons/Whatsapp.astro';
import { whatsappLinkeable } from '@/hooks/env.js';
---
<section class="relative overflow-hidden bg-featured py-20 text-inverse lg:py-28 dark:bg-featured-dark">
	<div
		class="pointer-events-none absolute inset-0 opacity-35 bg-[radial-gradient(circle_at_15%_50%,rgba(231,143,79,0.1)_0%,transparent_55%),radial-gradient(circle_at_90%_30%,rgba(201,162,39,0.07)_0%,transparent_50%)]"
		aria-hidden="true"
	></div>

	<div class="relative z-10 mx-auto max-w-7xl px-6">
		<div
			data-animate="section-block"
			class="flex flex-col items-center gap-10 lg:flex-row lg:items-center lg:justify-between lg:gap-16"
		>
			<div class="max-w-xl text-center lg:text-left">
				<p class="mb-4 text-[0.72rem] font-semibold tracking-[0.28em] text-primary-300 uppercase">
					Hablemos
				</p>
				<h2 class="text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl lg:leading-tight">
					Llevá la calidad y variedad de nuestros productos a tus clientes
				</h2>
				<div class="mx-auto my-5 h-1 w-16 rounded-sm bg-primary-400 lg:mx-0" aria-hidden="true"></div>
				<p class="text-base leading-relaxed text-inverse-muted lg:text-lg">
					¡Contactanos ahora para más detalles!
				</p>
			</div>

			<a
				href={'https://wa.me/' + whatsappLinkeable}
				class="group inline-flex w-full shrink-0 items-center justify-center gap-3 rounded-2xl border border-[#25d366]/30 bg-[#25d366] px-6 py-4 text-white transition-colors hover:bg-[#128C7E] sm:w-auto"
			>
				<Whatsapp extraClass="h-8 w-8" />
				<div class="text-left">
					<div class="text-[0.65rem] font-semibold tracking-[0.15em] uppercase opacity-90">
						Consúltenos
					</div>
					<div class="text-base font-bold">WhatsApp</div>
				</div>
			</a>
		</div>
	</div>
</section>
