---
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Products from '@/components/Products.vue';
---
<Layout 
	title="Catalogo"
	canonical="https://margon.com.ar/catalogo"
	metaTitle="MarGon - Catálogo de productos"
	metaDescription="Conocé nuestra extensa línea de alimentos: Sabores del Sol, Aral, Aralito, Viejo Minero y Condimax. Productos salados, dulces, golosinas, cócteles y aderezos."
	metaImg="https://margon.com.ar/images/logos/aral_azul.webp"
	preLoad="images/logos/aral_azul.webp"
>
	<Breadcrumb
		page="Catálogo"
		title="Nuestros productos"
		description="Conocé nuestra extensa línea de alimentos"
	/>
	<Products client:load />
</Layout>
