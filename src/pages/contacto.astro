---
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import ContactInfo from '@/components/ContactInfo.astro';
import FormContact from '@/components/FormContact.vue';
import { mapIframe, siteKey, telphoneReadble } from '@/hooks/env.js';
---
<Layout
	title="Contacto"
	canonical="https://margon.com.ar/contacto"
	metaTitle="MarGon - Contacto"
	metaDescription={'¿Quiéres ser distribuidor? Contáctenos para saber más sobre nuestras marcas Aral, Aralito, Viejo Minero, Condimax y Sabores del Sol, y sus productos. Escríbanos ' + telphoneReadble}
	metaImg="https://margon.com.ar/images/logos/margon_meta.webp"
	preLoad="images/contact.webp"
>
	<Breadcrumb
		page="Contacto"
		title="Contacto"
		description="Contáctenos para obtener nuestros productos"
	/>

	<section class="bg-body pt-4 pb-20 dark:bg-body-dark lg:pb-28">
		<div class="mx-auto max-w-7xl px-6">
			<div class="grid gap-10 lg:grid-cols-12 lg:items-start lg:gap-12">
				<div class="lg:col-span-7">
					<FormContact client:load />
				</div>
				<div class="lg:col-span-5">
					<ContactInfo />
				</div>
			</div>
		</div>
	</section>

	<section class="bg-tint py-16 dark:bg-tint-dark lg:py-20">
		<div class="mx-auto max-w-7xl px-6">
			<header class="mb-10 text-center">
				<p class="mb-3 text-[0.72rem] font-semibold tracking-[0.28em] text-primary-600 uppercase dark:text-primary-300">
					Ubicación
				</p>
				<h2 class="text-2xl font-black tracking-tight text-foreground sm:text-3xl dark:text-inverse">
					Encontranos en el mapa
				</h2>
				<div class="mx-auto mt-4 h-1 w-12 rounded-sm bg-primary-500 dark:bg-primary-400" aria-hidden="true"></div>
			</header>
			<div
				class="overflow-hidden rounded-2xl border border-border-warm shadow-sm dark:border-border-warm-dark [&_iframe]:block [&_iframe]:aspect-video [&_iframe]:h-auto [&_iframe]:min-h-[280px] [&_iframe]:w-full sm:[&_iframe]:min-h-[360px] lg:[&_iframe]:min-h-[420px]"
				set:html={mapIframe}
			>
			</div>
		</div>
	</section>
</Layout>

<script async src={'https://www.google.com/recaptcha/api.js?render=' + siteKey}></script>
